import { ScrollView } from "std-widgets.slint";

export struct RowData {
    id: int,
    title: string,
}

global Theme {
    out property <length> row-height: 28px;
    out property <length> gap: 6px;
    out property <length> indicator-height: 2px;
    out property <color> background: #1e1f22;
    out property <color> row: #2b2d31;
    out property <color> row-dragging: #3a3d44;
    out property <color> text: #e6e6e6;
    out property <color> accent: #f0a030;
    out property <color> group-header: #8a8f98;
}

component Row inherits Rectangle {
    in property <RowData> data;
    in property <bool> indicator-above;
    in property <bool> indicator-below;
    pure callback payload(RowData) -> data-transfer;
    callback finished();

    height: Theme.row-height;
    background: drag.dragging ? Theme.row-dragging : Theme.row;
    border-radius: 4px;

    Text {
        x: 8px;
        text: root.data.title;
        color: Theme.text;
        vertical-alignment: center;
    }

    drag := DragArea {
        data: root.payload(root.data);
        allow-move: true;
        drag-finished(action) => { root.finished(); }
        // A mouse-handling child keeps the DragArea reliably hit by later presses;
        // without one, drags from most rows stop starting after the first drop.
        TouchArea {
            mouse-cursor: MouseCursor.grab;
        }
    }

    Rectangle {
        visible: root.indicator-above;
        y: 0;
        height: Theme.indicator-height;
        background: Theme.accent;
    }

    Rectangle {
        visible: root.indicator-below;
        y: root.height - self.height;
        height: Theme.indicator-height;
        background: Theme.accent;
    }
}

component Group inherits Rectangle {
    in property <string> name;
    in property <int> group-index;
    in property <[RowData]> rows;
    // Insertion slot shown as the drop indicator, or -1.
    in property <int> indicator-slot;
    pure callback payload(RowData) -> data-transfer;
    callback hover(int, int);
    callback drop(data-transfer, int, int);
    callback finished();

    VerticalLayout {
        spacing: Theme.gap;
        Text {
            text: root.name;
            color: Theme.group-header;
            font-weight: 700;
        }
        VerticalLayout {
            spacing: 2px;
            for row[i] in root.rows: Rectangle {
                height: Theme.row-height;
                DropArea {
                    can-drop(event) => {
                        root.hover(root.group-index, i + (event.position.y > Theme.row-height / 2 ? 1 : 0));
                        DragAction.move
                    }
                    dropped(event) => {
                        root.drop(event.data, root.group-index, i + (event.position.y > Theme.row-height / 2 ? 1 : 0));
                        DragAction.move
                    }
                    Row {
                        data: row;
                        indicator-above: root.indicator-slot == i;
                        indicator-below: i == root.rows.length - 1 && root.indicator-slot == root.rows.length;
                        payload(r) => { root.payload(r) }
                        finished => { root.finished(); }
                    }
                }
            }
        }
        // Empty space below the rows: dropping here appends to the group.
        Rectangle {
            vertical-stretch: 1;
            min-height: Theme.row-height;
            DropArea {
                can-drop(event) => {
                    root.hover(root.group-index, root.rows.length);
                    DragAction.move
                }
                dropped(event) => {
                    root.drop(event.data, root.group-index, root.rows.length);
                    DragAction.move
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Pohunek Companion";
    preferred-width: 320px;
    preferred-height: 800px;
    background: Theme.background;

    in property <[RowData]> group-a;
    in property <[RowData]> group-b;
    in property <string> status;
    in-out property <int> indicator-group: -1;
    in-out property <int> indicator-slot: -1;
    pure callback payload(RowData) -> data-transfer;
    callback drop(data-transfer, int, int);

    VerticalLayout {
        padding: 8px;
        spacing: Theme.gap;
        Text {
            text: root.status;
            color: Theme.text;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: Theme.gap;
            for name[g] in ["Inbox", "Review"]: Group {
                name: name;
                group-index: g;
                rows: g == 0 ? root.group-a : root.group-b;
                indicator-slot: root.indicator-group == g ? root.indicator-slot : -1;
                payload(r) => { root.payload(r) }
                hover(gi, slot) => {
                    root.indicator-group = gi;
                    root.indicator-slot = slot;
                }
                drop(data, gi, slot) => {
                    root.indicator-group = -1;
                    root.indicator-slot = -1;
                    root.drop(data, gi, slot);
                }
                finished => {
                    root.indicator-group = -1;
                    root.indicator-slot = -1;
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <image> tray-icon;
    in property <string> tray-tooltip;
    in property <string> needs-label;
    in property <string> ticks-label;
    callback show-window();
    callback bump();
    callback quit();

    icon: root.tray-icon;
    tooltip: root.tray-tooltip;

    Menu {
        MenuItem {
            title: root.needs-label;
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.ticks-label;
            activated => { root.bump(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
    clicked => { root.show-window(); }
}
