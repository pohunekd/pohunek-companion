import { CheckBox, LineEdit, TextEdit } from "std-widgets.slint";
import { ChoiceChips } from "choice_chips.slint";
import { Theme } from "app.slint";

global DialogTheme {
    out property <length> padding: 16px;
    out property <length> spacing: 10px;
    out property <length> label-font-size: 12px;
    out property <length> field-spacing: 4px;
    out property <length> prompt-height: 90px;
    out property <length> button-height: 30px;
    out property <length> button-width: 96px;
    out property <length> button-radius: 4px;
    out property <length> focus-border-width: 1px;
    out property <length> focus-radius: 14px;
    out property <color> focus-border: #4a6fa5;
    out property <color> button-disabled: #3a3d44;
    out property <color> chip-disabled-text: #5d6068;
    out property <length> field-height: 30px;
    out property <length> field-padding: 8px;
    out property <length> field-radius: 4px;
    out property <length> list-row-height: 26px;
    out property <int> list-max-rows: 8;
    out property <length> list-gap: 2px;
    out property <length> list-border-width: 1px;
    out property <color> list-background: #26282c;
    out property <color> list-border: #3a3d44;
    out property <length> field-font-size: 13px;
}

// Fuzzy matching lives in Rust (`pohunek_companion_core::fuzzy_matches`): the
// indices of `items` that match `query`, in their order.
export global Fuzzy {
    pure callback matches(string, [string]) -> [int];
}

// A searchable select: a text field showing the current choice and a list
// drawn under it. Typing narrows the list, Up and Down move the highlight,
// Enter picks, Escape closes the list. The list opens when the field gains
// focus, so typing starts a search at once.
component SearchSelect inherits Rectangle {
    in property <[string]> model;
    // Unlaunchable entries are listed but cannot be picked.
    in property <[bool]> disabled;
    in property <string> placeholder: "Select...";
    in-out property <int> selected-index: -1;
    out property <bool> list-open: false;
    callback selected(int);

    property <string> query;
    property <int> highlight: 0;
    property <[int]> filtered: Fuzzy.matches(root.query, root.model);
    property <string> current: root.selected-index >= 0 && root.selected-index < root.model.length
        ? root.model[root.selected-index] : "";

    min-height: DialogTheme.field-height;
    max-height: DialogTheme.field-height;
    forward-focus: input;
    background: Theme.chip-background;
    border-radius: DialogTheme.field-radius;
    border-width: input.has-focus ? DialogTheme.focus-border-width : 0px;
    border-color: DialogTheme.focus-border;

    // Handles a navigation key of the focused field before its `TextInput`
    // sees it; returns whether the key was consumed.
    public function handle-key(text: string, control: bool) -> bool {
        if text == Key.DownArrow {
            root.move(1);
            return true;
        }
        if text == Key.UpArrow {
            root.move(-1);
            return true;
        }
        if text == Key.Return && !control {
            if root.list-open {
                root.pick(root.highlight);
            } else {
                root.list-open = true;
            }
            return true;
        }
        if text == Key.Escape && root.list-open {
            root.close();
            return true;
        }
        return false;
    }

    public function close() {
        root.list-open = false;
        root.query = "";
    }

    function reset-highlight() {
        root.highlight = 0;
        list-flick.content-y = 0px;
    }

    function pick(row: int) {
        if row < 0 || row >= root.filtered.length || root.disabled[root.filtered[row]] {
            return;
        }
        root.selected-index = root.filtered[row];
        root.selected(root.filtered[row]);
        root.close();
    }

    function move(delta: int) {
        root.list-open = true;
        root.highlight = clamp(root.highlight + delta, 0, max(root.filtered.length - 1, 0));
        if root.highlight * DialogTheme.list-row-height < -list-flick.content-y {
            list-flick.content-y = -root.highlight * DialogTheme.list-row-height;
        } else if (root.highlight + 1) * DialogTheme.list-row-height > -list-flick.content-y + list-flick.height {
            list-flick.content-y = list-flick.height - (root.highlight + 1) * DialogTheme.list-row-height;
        }
    }

    changed filtered => {
        root.highlight = clamp(root.highlight, 0, max(root.filtered.length - 1, 0));
    }

    out property <bool> focused: input.has-focus;
    changed focused => {
        root.query = "";
        root.reset-highlight();
        root.list-open = root.focused;
    }

    Rectangle {
        Text {
            x: DialogTheme.field-padding;
            width: parent.width - 2 * DialogTheme.field-padding;
            height: parent.height;
            text: root.query != "" ? "" : root.current != "" ? root.current : root.placeholder;
            color: root.current != "" && !root.list-open ? Theme.text : Theme.detail;
            font-size: DialogTheme.field-font-size;
            vertical-alignment: center;
            overflow: elide;
        }

        input := TextInput {
            x: DialogTheme.field-padding;
            width: parent.width - 2 * DialogTheme.field-padding;
            height: parent.height;
            text <=> root.query;
            color: Theme.text;
            font-size: DialogTheme.field-font-size;
            vertical-alignment: center;
            single-line: true;
            edited => {
                root.list-open = true;
                root.reset-highlight();
            }
        }

        TouchArea {
            clicked => {
                if input.has-focus {
                    root.list-open = !root.list-open;
                } else {
                    input.focus();
                    root.list-open = true;
                }
            }
        }
    }

    Rectangle {
        visible: root.list-open;
        y: root.height + DialogTheme.list-gap;
        width: root.width;
        height: max(min(root.filtered.length, DialogTheme.list-max-rows), 1) * DialogTheme.list-row-height
            + 2 * DialogTheme.list-border-width;
        background: DialogTheme.list-background;
        border-radius: DialogTheme.field-radius;
        border-width: DialogTheme.list-border-width;
        border-color: DialogTheme.list-border;

        if root.filtered.length == 0: Text {
            x: DialogTheme.field-padding;
            text: "No match";
            color: Theme.detail;
            font-size: DialogTheme.field-font-size;
            vertical-alignment: center;
        }
        list-flick := Flickable {
            x: DialogTheme.list-border-width;
            y: DialogTheme.list-border-width;
            width: parent.width - 2 * DialogTheme.list-border-width;
            height: parent.height - 2 * DialogTheme.list-border-width;
            content-height: root.filtered.length * DialogTheme.list-row-height;
            for index[row] in root.filtered: Rectangle {
                y: row * DialogTheme.list-row-height;
                height: DialogTheme.list-row-height;
                background: row == root.highlight ? Theme.chip-selected-background
                    : row-touch.has-hover && !root.disabled[index] ? Theme.chip-hover-background
                    : transparent;
                Text {
                    x: DialogTheme.field-padding;
                    width: parent.width - 2 * DialogTheme.field-padding;
                    text: root.model[index];
                    color: root.disabled[index] ? DialogTheme.chip-disabled-text
                        : row == root.highlight ? Theme.text
                        : index == root.selected-index ? Theme.text : Theme.detail;
                    font-size: DialogTheme.field-font-size;
                    vertical-alignment: center;
                    overflow: elide;
                }
                row-touch := TouchArea {
                    clicked => { root.pick(row); }
                }
            }
        }
    }
}

// A single-choice chip row that takes keyboard focus: Left and Right move the
// selection.
component ChipField inherits FocusScope {
    in property <[string]> model;
    in-out property <int> selected-index: -1;
    callback selected(int);

    key-pressed(event) => {
        if event.text == Key.RightArrow && root.selected-index < root.model.length - 1 {
            root.selected-index += 1;
            root.selected(root.selected-index);
            return accept;
        }
        if event.text == Key.LeftArrow && root.selected-index > 0 {
            root.selected-index -= 1;
            root.selected(root.selected-index);
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-width: root.has-focus ? DialogTheme.focus-border-width : 0px;
        border-color: DialogTheme.focus-border;
        border-radius: DialogTheme.focus-radius;
        ChoiceChips {
            model: root.model;
            selected-index <=> root.selected-index;
            chip-height: Theme.chip-height;
            chip-padding: Theme.chip-padding;
            chip-radius: Theme.chip-radius;
            chip-spacing: Theme.chip-spacing;
            font-size: Theme.chip-font-size;
            chip-background: Theme.chip-background;
            chip-hover-background: Theme.chip-hover-background;
            chip-selected-background: Theme.chip-selected-background;
            text-color: Theme.detail;
            selected-text-color: Theme.text;
            selected(index) => {
                root.focus();
                root.selected(index);
            }
        }
    }
}

component FieldLabel inherits Text {
    // Keeps the label at its text height when a field below it is fixed-size.
    max-height: self.preferred-height;
    font-size: DialogTheme.label-font-size;
    color: Theme.detail;
}

export component NewSessionWindow inherits Window {
    title: "New session";
    preferred-width: 480px;
    preferred-height: 520px;
    background: Theme.background;
    forward-focus: project-field;

    // Project labels and launchable agent names, in the order offered.
    in property <[string]> project-names;
    in property <[string]> agent-names;
    // Parallel to `agent-names`: true for an agent that cannot be launched.
    in property <[bool]> agent-disabled;
    // One line per unlaunchable agent: `name: reason`.
    in property <string> agent-notes;
    // Why Create is disabled; empty when it is allowed.
    in property <string> blocker;
    in-out property <int> project-index: -1;
    in-out property <int> agent-index: -1;
    in-out property <string> session-name;
    in-out property <string> prompt;
    // "Blank" followed by the project's templates; index 0 is Blank.
    in property <[string]> template-names;
    in-out property <int> template-index: 0;
    // A chosen template's recipe is still being read from the daemon.
    in property <bool> template-loading;
    in-out property <string> branch;
    in-out property <string> base-branch;
    in-out property <bool> advanced-open: false;
    // The choices are still being read from the daemon.
    in property <bool> loading: true;
    // A create request is in flight, or its outcome is unknown and it must
    // not be repeated.
    in property <bool> busy;
    // Why the choices or the create failed; empty when there is nothing to show.
    in property <string> error;
    // The session exists but could not be attached; Create is not offered again.
    in property <bool> created;
    in-out property <bool> attach-after-create: true;
    callback project-changed(int);
    callback agent-changed(int);
    // The branch or base branch text changed.
    callback overrides-edited();
    callback template-chosen(int);
    callback submit();
    callback cancel();

    pure function can-submit() -> bool {
        !root.loading && !root.busy && !root.created && !root.template-loading
            && root.project-index >= 0 && root.agent-index >= 0 && root.blocker == ""
    }

    function try-submit() {
        if root.can-submit() {
            root.submit();
        }
    }

    FocusScope {
        // Captured before the focused field sees the key: `TextEdit` consumes
        // Enter itself.
        capture-key-pressed(event) => {
            if project-field.focused && project-field.handle-key(event.text, event.modifiers.control) {
                return accept;
            }
            if agent-field.focused && agent-field.handle-key(event.text, event.modifiers.control) {
                return accept;
            }
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return && event.modifiers.control {
                root.try-submit();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: DialogTheme.padding;
            spacing: DialogTheme.spacing;

            VerticalLayout {
                // Above the fields below, which the open list overlaps.
                z: project-field.list-open ? 2 : 0;
                spacing: DialogTheme.field-spacing;
                FieldLabel { text: "Project"; }
                project-field := SearchSelect {
                    model: root.project-names;
                    selected-index <=> root.project-index;
                    selected(index) => { root.project-changed(index); }
                }
            }
            VerticalLayout {
                z: agent-field.list-open ? 2 : 0;
                spacing: DialogTheme.field-spacing;
                FieldLabel { text: "Agent"; }
                agent-field := SearchSelect {
                    model: root.agent-names;
                    disabled: root.agent-disabled;
                    selected-index <=> root.agent-index;
                    selected(index) => { root.agent-changed(index); }
                }
                if root.agent-notes != "": agent-notes-text := Text {
                    text: root.agent-notes;
                    color: Theme.detail;
                    font-size: Theme.detail-font-size;
                    wrap: word-wrap;
                }
            }
            if root.template-names.length > 1: VerticalLayout {
                spacing: DialogTheme.field-spacing;
                FieldLabel { text: root.template-loading ? "Template (loading...)" : "Template"; }
                template-field := ChipField {
                    model: root.template-names;
                    selected-index <=> root.template-index;
                    selected(index) => { root.template-chosen(index); }
                }
            }
            VerticalLayout {
                spacing: DialogTheme.field-spacing;
                FieldLabel { text: "Name (optional)"; }
                name-edit := LineEdit {
                    text <=> root.session-name;
                    accepted => { root.try-submit(); }
                }
            }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: DialogTheme.field-spacing;
                FieldLabel { text: "Prompt (optional, Ctrl+Enter creates)"; }
                prompt-edit := TextEdit {
                    text <=> root.prompt;
                    min-height: DialogTheme.prompt-height;
                    wrap: word-wrap;
                }
            }
            if root.template-index == 0: VerticalLayout {
                spacing: DialogTheme.field-spacing;
                advanced-toggle := Rectangle {
                    height: DialogTheme.button-height;
                    Text {
                        text: (root.advanced-open ? "v " : "> ") + "Advanced";
                        color: Theme.detail;
                        font-size: DialogTheme.label-font-size;
                        horizontal-alignment: left;
                    }
                    advanced-touch := TouchArea {
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                }
                if root.advanced-open: VerticalLayout {
                    spacing: DialogTheme.field-spacing;
                    FieldLabel { text: "Branch (optional)"; }
                    branch-edit := LineEdit {
                        text <=> root.branch;
                        edited => { root.overrides-edited(); }
                    }
                    FieldLabel { text: "Base branch (optional)"; }
                    base-branch-edit := LineEdit {
                        text <=> root.base-branch;
                        edited => { root.overrides-edited(); }
                    }
                }
            }
            attach-checkbox := CheckBox {
                text: "Attach after creating";
                checked <=> root.attach-after-create;
                enabled: !root.busy && !root.created;
            }
            if root.error != "": error-text := Text {
                text: root.error;
                color: Theme.error;
                font-size: Theme.error-font-size;
                wrap: word-wrap;
            }
            if root.blocker != "": blocker-text := Text {
                text: root.blocker;
                color: Theme.detail;
                font-size: Theme.error-font-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: DialogTheme.spacing;
                cancel-button := Rectangle {
                    width: DialogTheme.button-width;
                    height: DialogTheme.button-height;
                    border-radius: DialogTheme.button-radius;
                    background: cancel-touch.has-hover ? Theme.chip-hover-background : Theme.chip-background;
                    Text {
                        text: root.created ? "Close" : "Cancel";
                        color: Theme.text;
                    }
                    cancel-touch := TouchArea {
                        clicked => { root.cancel(); }
                    }
                }
                create-button := FocusScope {
                    width: DialogTheme.button-width;
                    height: DialogTheme.button-height;
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == " " {
                            root.try-submit();
                            return accept;
                        }
                        return reject;
                    }
                    Rectangle {
                        border-radius: DialogTheme.button-radius;
                        border-width: create-button.has-focus ? DialogTheme.focus-border-width : 0px;
                        border-color: DialogTheme.focus-border;
                        background: !root.can-submit() ? DialogTheme.button-disabled
                            : create-touch.has-hover ? Theme.chip-selected-background.brighter(0.2)
                            : Theme.chip-selected-background;
                        Text {
                            text: root.busy ? "Creating..." : "Create";
                            color: root.can-submit() ? Theme.text : Theme.detail;
                        }
                        create-touch := TouchArea {
                            enabled: root.can-submit();
                            clicked => { root.try-submit(); }
                        }
                    }
                }
            }
        }
    }
}
