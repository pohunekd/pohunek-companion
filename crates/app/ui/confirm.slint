import { ScrollView } from "std-widgets.slint";
import { Theme } from "app.slint";

global ConfirmTheme {
    out property <length> padding: 16px;
    out property <length> spacing: 12px;
    out property <length> button-height: 30px;
    out property <length> button-width: 120px;
    out property <length> button-radius: 4px;
    out property <length> title-font-size: 15px;
    out property <length> body-font-size: 13px;
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    // The button Enter activates.
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    width: ConfirmTheme.button-width;
    height: ConfirmTheme.button-height;
    border-radius: ConfirmTheme.button-radius;
    background: touch.has-hover && root.enabled ? Theme.chip-hover-background : Theme.chip-background;
    border-width: root.selected ? Theme.confirm-selected-border : Theme.confirm-border;
    border-color: root.accent;
    accessible-role: button;
    accessible-label: root.label;
    Text {
        text: root.label;
        color: root.enabled ? root.accent : Theme.detail;
        font-size: ConfirmTheme.body-font-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Confirms a destructive session action. The default button is Cancel; the
// destructive button needs a click, or Tab and then Enter.
export component ConfirmWindow inherits Window {
    title: root.heading;
    preferred-width: 420px;
    preferred-height: 300px;
    background: Theme.background;
    forward-focus: keys;

    // "stop", "remove" or "remove-anyway".
    in property <string> kind;
    in property <string> name;
    // Window title and the destructive button's label for `kind`.
    in property <string> heading;
    in property <string> confirm-label;
    // What the action does, in plain words.
    in property <string> consequence;
    // The action is in flight.
    in property <bool> busy;
    // Why the last attempt failed; empty when none did.
    in property <string> error;
    // A completed action left something for the owner to handle; only Close is offered.
    in property <string> notice;
    in-out property <bool> confirm-selected;
    callback confirm();
    callback cancel();

    pure function finished() -> bool {
        root.notice != ""
    }

    function activate-selected() {
        if root.busy {
            return;
        }
        if root.finished() || !root.confirm-selected {
            root.cancel();
        } else {
            root.confirm();
        }
    }

    keys := FocusScope {
        // Captured so a focused button never changes what Enter does.
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if root.busy || root.finished() {
                if event.text == Key.Return {
                    root.activate-selected();
                    return accept;
                }
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.confirm-selected = false;
                return accept;
            }
            if event.text == Key.RightArrow {
                root.confirm-selected = true;
                return accept;
            }
            if event.text == Key.Tab {
                root.confirm-selected = !root.confirm-selected;
                return accept;
            }
            if event.text == Key.Return {
                root.activate-selected();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: ConfirmTheme.padding;
            spacing: ConfirmTheme.spacing;
            // The daemon's refusal text can be long; the buttons stay in view.
            body-scroll := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: ConfirmTheme.spacing;
                    Text {
                        text: root.heading + " " + root.name + "?";
                        color: Theme.text;
                        font-size: ConfirmTheme.title-font-size;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.consequence;
                        color: Theme.text;
                        font-size: ConfirmTheme.body-font-size;
                        wrap: word-wrap;
                    }
                    if root.error != "": error-text := Text {
                        text: root.error;
                        color: Theme.error;
                        font-size: ConfirmTheme.body-font-size;
                        wrap: word-wrap;
                    }
                    if root.notice != "": notice-text := Text {
                        text: root.notice;
                        color: Theme.detail;
                        font-size: ConfirmTheme.body-font-size;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: ConfirmTheme.spacing;
                cancel-button := DialogButton {
                    label: root.finished() ? "Close" : "Cancel";
                    accent: Theme.text;
                    selected: root.finished() || !root.confirm-selected;
                    enabled: !root.busy;
                    clicked => { root.cancel(); }
                }
                if !root.finished(): confirm-button := DialogButton {
                    label: root.busy ? "Working..." : root.confirm-label;
                    accent: Theme.error;
                    selected: root.confirm-selected;
                    enabled: !root.busy;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
