#!/bin/sh
# Runs the changelog contract tool (crates/changelog) from the repository root.
#
# usage: scripts/changelog check
#        scripts/changelog fold <version> [--surface <name>] [--date YYYY-MM-DD]
#        scripts/changelog notes <version> [--surface <name>]

set -eu

cd "$(dirname "$0")/.."
exec cargo run --quiet --locked -p pohunek-companion-changelog -- "$@"
